# Copia este archivo como .env y rellena los valores. El .env nunca se sube a git.
# Sin espacios alrededor del "=" ni al inicio de la línea.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Local (docker compose up -d mongo):
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
# Atlas (copia la URI desde Atlas → Connect → Drivers):
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/
# Nombre de la base de datos (opcional; por defecto playbookpro):
# MONGODB_DB_NAME=playbookpro
# Solo si al arrancar sale "querySrv ECONNREFUSED" con la URI de Atlas:
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Obligatorio, mínimo 32 caracteres. Firma los tokens de sesión. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
# Opcionales: duración del access token (segundos) y de la sesión (días).
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30

# Opcionales: subida de fotos del roster a Cloudinary (las tres juntas). Están en el
# panel de Cloudinary → Settings → API Keys. Sin ellas, las fotos se ponen con su URL.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
